{
  "name": "vscode-guitar-dsl",
  "displayName": "GuitarDSL Previewer",
  "description": "Guitar rhythm slash notation and tab score previewer for guitarDSL",
  "version": "0.1.0",
  "publisher": "puchinya",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:guitardsl",
    "onView:guitardsl.sidebar",
    "onLanguageModelTool:guitardsl_validate_dsl",
    "onLanguageModelTool:guitardsl_analyze_playability",
    "onLanguageModelTool:guitardsl_apply_capo",
    "onLanguageModelTool:guitardsl_apply_beginner_mode",
    "onLanguageModelTool:guitardsl_apply_transpose"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "guitardsl",
        "aliases": [
          "GuitarDSL",
          "guitardsl"
        ],
        "extensions": [
          ".guitardsl",
          ".gdsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "guitardsl",
        "scopeName": "source.guitardsl",
        "path": "./syntaxes/guitardsl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "guitardsl.showPreview",
        "title": "%command.showPreview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "guitardsl.exportPdf",
        "title": "%command.exportPdf.title%"
      },
      {
        "command": "guitardsl.editChordDiagram",
        "title": "%command.editChordDiagram.title%"
      },
      {
        "command": "guitardsl.editScoreSettings",
        "title": "%command.editScoreSettings.title%"
      },
      {
        "command": "guitardsl.editCapo",
        "title": "%command.editCapo.title%"
      },
      {
        "command": "guitardsl.transcribeYouTube",
        "title": "%command.transcribeYouTube.title%"
      },
      {
        "command": "guitardsl.transcribeAudio",
        "title": "%command.transcribeAudio.title%"
      },
      {
        "command": "guitardsl.setGeminiApiKey",
        "title": "%command.setGeminiApiKey.title%"
      },
      {
        "command": "guitardsl.clearGeminiApiKey",
        "title": "%command.clearGeminiApiKey.title%"
      },
      {
        "command": "guitardsl.applyStrummingPattern",
        "title": "%command.applyStrummingPattern.title%"
      },
      {
        "command": "guitardsl.openHelp",
        "title": "%command.openHelp.title%"
      },
      {
        "command": "guitardsl.newDocumentFromTemplate",
        "title": "%command.newDocumentFromTemplate.title%"
      },
      {
        "command": "guitardsl.openSample",
        "title": "%command.openSample.title%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "guitardslSidebar",
          "title": "%viewsContainer.guitardslSidebar.title%",
          "icon": "media/icons/guitardsl-sidebar.svg"
        }
      ]
    },
    "views": {
      "guitardslSidebar": [
        {
          "id": "guitardsl.sidebar",
          "name": "%view.sidebar.name%"
        }
      ]
    },
    "configuration": {
      "title": "GuitarDSL",
      "properties": {
        "guitardsl.gemini.model": {
          "type": "string",
          "default": "gemini-3.8-flash",
          "description": "%config.geminiModel.description%"
        },
        "guitardsl.transcription.compressRepeats": {
          "type": "boolean",
          "default": false,
          "description": "%config.compressRepeats.description%"
        },
        "guitardsl.expandPageBreakRepeats": {
          "type": "boolean",
          "default": true,
          "description": "%config.expandPageBreakRepeats.description%"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "guitardsl.showPreview",
          "when": "resourceLangId == guitardsl || resourceExtname == .guitardsl || resourceExtname == .gdsl",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "guitardsl.showPreview",
          "when": "resourceLangId == guitardsl || resourceExtname == .guitardsl || resourceExtname == .gdsl",
          "group": "navigation"
        }
      ]
    },
    "chatInstructions": [
      {
        "path": "./ai/instructions/guitardsl.instructions.md"
      }
    ],
    "chatSkills": [
      {
        "path": "./ai/skills/guitardsl-language/SKILL.md"
      }
    ],
    "languageModelTools": [
      {
        "name": "guitardsl_validate_dsl",
        "toolReferenceName": "guitardslValidate",
        "displayName": "%languageModelTools.validate.displayName%",
        "userDescription": "%languageModelTools.validate.userDescription%",
        "modelDescription": "Validate a GuitarDSL (.guitardsl/.gdsl) score with the extension's own parser and return its diagnostics as JSON (valid, errorCount, warningCount, diagnostics with 1-based line/startColumn/endColumn). Read-only. Call it after creating or materially editing GuitarDSL. Omit path to use the active GuitarDSL document.",
        "canBeReferencedInPrompt": true,
        "icon": "$(check)",
        "tags": [
          "guitardsl"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute file path of the GuitarDSL document. Omit to use the active GuitarDSL document."
            }
          }
        }
      },
      {
        "name": "guitardsl_analyze_playability",
        "toolReferenceName": "guitardslPlayability",
        "displayName": "%languageModelTools.playability.displayName%",
        "userDescription": "%languageModelTools.playability.userDescription%",
        "modelDescription": "Analyze capo playability of a GuitarDSL score with the extension's deterministic capo inference: returns sourceCapo, currentPlayability, recommendedCapo and one candidate per capo 0..12 (supported, score, level, reason). Read-only. Use it instead of estimating chord difficulty yourself.",
        "canBeReferencedInPrompt": true,
        "icon": "$(graph)",
        "tags": [
          "guitardsl"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute file path of the GuitarDSL document. Omit to use the active GuitarDSL document."
            }
          }
        }
      },
      {
        "name": "guitardsl_apply_capo",
        "toolReferenceName": "guitardslApplyCapo",
        "displayName": "%languageModelTools.applyCapo.displayName%",
        "userDescription": "%languageModelTools.applyCapo.userDescription%",
        "modelDescription": "Change the capo of a GuitarDSL score to targetCapo (0..12) while keeping the sounding harmony; the extension rewrites the capo header and chord names from the latest source in one undoable edit. Returns an operation summary and postValidationPassed, never the whole score. Fails without editing when a chord cannot be moved.",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-operator)",
        "tags": [
          "guitardsl"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute file path of the GuitarDSL document. Omit to use the active GuitarDSL document."
            },
            "targetCapo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12,
              "description": "Capo fret after the change."
            }
          },
          "required": [
            "targetCapo"
          ]
        }
      },
      {
        "name": "guitardsl_apply_beginner_mode",
        "toolReferenceName": "guitardslApplyBeginner",
        "displayName": "%languageModelTools.applyBeginner.displayName%",
        "userDescription": "%languageModelTools.applyBeginner.userDescription%",
        "modelDescription": "Apply Beginner Mode to a GuitarDSL score: the extension chooses an easy capo and simpler chord voicings that keep the sounding harmony, and rewrites the latest source in one undoable edit. barrePolicy allow/forbid controls barre chords; omit targetCapo for the automatic recommendation. Returns an operation summary and postValidationPassed.",
        "canBeReferencedInPrompt": true,
        "icon": "$(mortar-board)",
        "tags": [
          "guitardsl"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute file path of the GuitarDSL document. Omit to use the active GuitarDSL document."
            },
            "barrePolicy": {
              "type": "string",
              "enum": [
                "allow",
                "forbid"
              ],
              "description": "Whether barre chords may be used."
            },
            "targetCapo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12,
              "description": "Capo fret to use. Omit for the automatic recommendation."
            }
          },
          "required": [
            "barrePolicy"
          ]
        }
      },
      {
        "name": "guitardsl_apply_transpose",
        "toolReferenceName": "guitardslTranspose",
        "displayName": "%languageModelTools.transpose.displayName%",
        "userDescription": "%languageModelTools.transpose.userDescription%",
        "modelDescription": "Transpose the sounding music (key, chords, melody) of a GuitarDSL score by semitones (-11..11) and choose the capo afterwards: keep the current capo, use the recommended capo, or an explicit capo (capo is required only for capoMode explicit). The extension rewrites the latest source in one undoable edit and returns an operation summary and postValidationPassed.",
        "canBeReferencedInPrompt": true,
        "icon": "$(arrow-swap)",
        "tags": [
          "guitardsl"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute file path of the GuitarDSL document. Omit to use the active GuitarDSL document."
            },
            "semitones": {
              "type": "integer",
              "minimum": -11,
              "maximum": 11,
              "description": "Sounding transposition in semitones."
            },
            "capoMode": {
              "type": "string",
              "enum": [
                "keep",
                "recommended",
                "explicit"
              ],
              "description": "Capo after transposing."
            },
            "capo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12,
              "description": "Capo fret; required only when capoMode is 'explicit'."
            }
          },
          "required": [
            "semitones",
            "capoMode"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:audio-mir && npm run compile",
    "build:audio-mir": "wasm-pack build wasm/crates/audio-mir --target nodejs --release --out-dir ../../../media/audio-mir-wasm --out-name guitardsl_audio_mir",
    "test:audio-mir-wasm": "node --import tsx scripts/test-audio-mir-wasm.mjs",
    "generate:help": "node scripts/generate-help.mjs",
    "check:help": "node scripts/check-help-sync.mjs",
    "generate:ai": "node scripts/generate-ai-assets.mjs",
    "check:ai": "node scripts/check-ai-sync.mjs",
    "precompile": "npm run generate:help && npm run generate:ai",
    "compile": "tsc -p ./",
    "compile:tests": "tsc -p ./tests",
    "compile:all": "npm run compile && npm run compile:tests",
    "watch": "tsc -watch -p ./",
    "test:unit": "mocha -r tsx -r ./tests/unit/setup.ts 'tests/unit/**/*.test.ts'",
    "test:e2e": "npm run compile:all && node out/tests/e2e/runTest.js",
    "test": "npm run check:help && npm run check:ai && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.17.6",
    "@types/vscode": "^1.109.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "pdfkit": "^0.20.2",
    "svg-to-pdfkit": "^0.1.8"
  }
}
