{
  "name": "vscode-guitar-dsl",
  "displayName": "GuitarDSL Previewer",
  "description": "Guitar rhythm slash notation and tab score previewer for guitarDSL",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:guitardsl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "guitardsl",
        "aliases": [
          "GuitarDSL",
          "guitardsl"
        ],
        "extensions": [
          ".guitardsl",
          ".gdsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "guitardsl",
        "scopeName": "source.guitardsl",
        "path": "./syntaxes/guitardsl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "guitardsl.showPreview",
        "title": "GuitarDSL: Open Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "guitardsl.exportPdf",
        "title": "GuitarDSL: Export PDF / Print"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "guitardsl.showPreview",
          "when": "resourceLangId == guitardsl",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
