{
  "name": "vscode-guitar-dsl",
  "displayName": "GuitarDSL Previewer",
  "description": "Guitar rhythm slash notation and tab score previewer for guitarDSL",
  "version": "0.1.0",
  "publisher": "puchinya",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:guitardsl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "guitardsl",
        "aliases": [
          "GuitarDSL",
          "guitardsl"
        ],
        "extensions": [
          ".guitardsl",
          ".gdsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "guitardsl",
        "scopeName": "source.guitardsl",
        "path": "./syntaxes/guitardsl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "guitardsl.showPreview",
        "title": "%command.showPreview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "guitardsl.exportPdf",
        "title": "%command.exportPdf.title%"
      },
      {
        "command": "guitardsl.editChordDiagram",
        "title": "%command.editChordDiagram.title%"
      },
      {
        "command": "guitardsl.transcribeYouTube",
        "title": "%command.transcribeYouTube.title%"
      },
      {
        "command": "guitardsl.setGeminiApiKey",
        "title": "%command.setGeminiApiKey.title%"
      },
      {
        "command": "guitardsl.clearGeminiApiKey",
        "title": "%command.clearGeminiApiKey.title%"
      },
      {
        "command": "guitardsl.applyStrummingPattern",
        "title": "%command.applyStrummingPattern.title%"
      }
    ],
    "configuration": {
      "title": "GuitarDSL",
      "properties": {
        "guitardsl.gemini.model": {
          "type": "string",
          "default": "gemini-3.8-flash",
          "description": "%config.geminiModel.description%"
        },
        "guitardsl.transcription.compressRepeats": {
          "type": "boolean",
          "default": false,
          "description": "%config.compressRepeats.description%"
        },
        "guitardsl.expandPageBreakRepeats": {
          "type": "boolean",
          "default": true,
          "description": "%config.expandPageBreakRepeats.description%"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "guitardsl.showPreview",
          "when": "resourceLangId == guitardsl || resourceExtname == .guitardsl || resourceExtname == .gdsl",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "guitardsl.showPreview",
          "when": "resourceLangId == guitardsl || resourceExtname == .guitardsl || resourceExtname == .gdsl",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile:tests": "tsc -p ./tests",
    "compile:all": "npm run compile && npm run compile:tests",
    "watch": "tsc -watch -p ./",
    "test:unit": "mocha -r tsx -r ./tests/unit/setup.ts 'tests/unit/**/*.test.ts'",
    "test:e2e": "npm run compile:all && node out/tests/e2e/runTest.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.17.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "pdfkit": "^0.20.2",
    "svg-to-pdfkit": "^0.1.8"
  }
}
