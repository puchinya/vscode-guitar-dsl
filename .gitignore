# 依存関係
node_modules/
jspm_packages/
web_modules/

# TypeScript コンパイル出力
out/
dist/
build/
*.tsbuildinfo

# ログファイル
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 環境変数・シークレット
.env
.env.local
.env.*.local

# エディタ・OS 固有ファイル
.DS_Store
Thumbs.db
*.sublime-workspace
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code（個人設定やテスト用バイナリを除外）
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode-test/

# パッケージング・配布アーカイブ
*.vsix
*.tgz
*.zip

# テスト・カバレッジ
coverage/
.nyc_output/

# Agent workflow state (scripts/agent/* write Issue-scoped mirrors, logs, self-review)
.agent-state/

# Audio MIR (Rust/WASM) build output
media/audio-mir-wasm/
wasm/target/
# alternate CARGO_TARGET_DIRs (e.g. a separate target for tests while tuning runs)
wasm/target-*/
**/*.rs.bk
# SwiftPM / compiled helper binaries (scripts/render-audio-mir-synth-set.swift)
.build/
scripts/render-audio-mir-synth-set

# Audio MIR evaluation data is local-only (datasets live on Google Drive, never in the repo)
*.wav
*.wave
*.aif
*.aiff
*.caf
*.mp3
*.m4a
*.flac
*.jams
*.lab
