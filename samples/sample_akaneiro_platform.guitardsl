title: 茜色のプラットホーム
artist: GuitarDSL Original
tuning: Standard
capo: 0
key: C
bpm: 116
time: 4/4
feel: straight
measures_per_row: 4
memo: 16分音符やシンコペーションを織り交ぜた王道J-POPナンバー。

# 分数コードのカスタムフォーム定義（§7.4）
chord E7/G# = 420100 fingers:42-1--

# リズムパターンの再利用フラグメント定義（§17）
let intro_arp    = 4.d.arp 8.d 8.u 4.d.arp 8.d 8.u
let verse_beat   = 4.d 8.d 8.u 8.d 8.u 4.d
let pre_beat     = 8.d.pm 8.d.pm 8.d.pm 8.d.pm 8.d 8.u 4.d.a
let chorus_beat  = 8.d 8.u 4.d.a 8.u 8.d 8.d.a 8.u
let chorus_drive = 8.d 16.d 16.u 8.d 8.u 8.d 8.u 8.d 8.u

[Intro]
