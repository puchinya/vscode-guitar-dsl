{
  "name": "@guitardsl/ui",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": { "*": ["dist/*.d.ts"] }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@guitardsl/core": "0.1.0",
    "@guitardsl/document": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/sync-inspector-script.mjs"
  }
}
