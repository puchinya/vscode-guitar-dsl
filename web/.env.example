# Google Cloud public browser credentials. Restrict the API key to Google Picker and
# your deployed HTTP referrers. Never put a client secret in this file.
VITE_GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-restricted-google-api-key
VITE_GOOGLE_APP_ID=your-google-cloud-project-number
