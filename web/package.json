{
  "name": "@guitardsl/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@guitardsl/core": "0.1.0",
    "@guitardsl/document": "0.1.0",
    "@guitardsl/pdf": "0.1.0",
    "@guitardsl/ui": "0.1.0",
    "pdfkit": "^0.20.2",
    "svg-to-pdfkit": "^0.1.8"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "playwright test --config playwright.firefox.config.ts",
    "test:safari": "node scripts/run-safari-e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "selenium-webdriver": "^4.51.0",
    "vite": "^8.3.8"
  }
}
