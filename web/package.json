{
  "name": "@guitardsl/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@guitardsl/core": "0.1.0",
    "@guitardsl/document": "0.1.0",
    "@guitardsl/pdf": "0.1.0",
    "@guitardsl/ui": "0.1.0",
    "@vue/devtools-api": "^8.2.1",
    "pdfkit": "^0.20.2",
    "pinia": "^4.1.0",
    "svg-to-pdfkit": "^0.1.8",
    "vue": "^3.5.45"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:e2e:firefox": "playwright test --config playwright.firefox.config.ts",
    "test:safari": "node scripts/run-safari-e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "selenium-webdriver": "^4.51.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.14"
  }
}
