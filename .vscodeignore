# Development / agent state
.agent/**
.agent-state/**
.agents/**
.codex/**
.claude/**
.claude-plugin/**
.github/**
.vscode/**
.vscode-test/**
.gitignore

# Sources, tests and build helpers (the extension runs from out/)
src/**
tests/**
out/tests/**
scripts/**
plugins/**
**/tsconfig.json
**/*.ts
**/*.map

# Rust/WASM sources and Cargo output (only the generated media/audio-mir-wasm runtime ships)
wasm/**
media/audio-mir-wasm/.gitignore
media/audio-mir-wasm/package.json
media/audio-mir-wasm/README.md

# Documentation for developers / agents
docs/**
docs_only_human/**
AGENTS.md
CLAUDE.md

# Sample scores (the curated samples opened by guitardsl.openSample ship; keep in sync with src/onboarding.ts)
samples/**
!samples/sample.guitardsl
!samples/sample_melody.guitardsl
!samples/sample_leadsheet.guitardsl
!samples/sample_voicings.guitardsl
!samples/sample_notes.guitardsl
